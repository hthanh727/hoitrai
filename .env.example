# Kết nối Aiven PostgreSQL
DATABASE_URL="postgres://avnadmin:PASSWORD@HOST:PORT/defaultdb?sslmode=require"

# Chứng chỉ CA từ Aiven (dạng Base64) hoặc dùng ca.pem
DATABASE_CA_CERT_BASE64=""

# Khóa JWT bảo mật
JWT_SECRET="generate-a-secure-random-jwt-secret-here"

# Tài khoản Admin khởi tạo ban đầu
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="YourPassword123"
ADMIN_NAME="Quản trị hội trại"

# Bật dữ liệu mẫu (món ăn, gian hàng minh họa)
SEED_SAMPLE_DATA=false
